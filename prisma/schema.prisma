generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                @id @default(uuid())
  name                 String?
  email                String                @unique
  passwordHash         String?
  phone                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  emailVerified        DateTime?
  image                String?
  authProviders        Account[]
  consultationBookings ConsultationBooking[]
  newsletters          NewsletterEntry[]
  reviews              Review[]
  sessions             Session[]
  Transactions         Transactions[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  access_token      String?
  expires_at        Int?
  providerAccountId String
  refresh_token     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Admin {
  id                  String                @id @default(uuid())
  name                String?
  email               String                @unique
  passwordHash        String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  role                StaffRole             @default(admin)
  mustChangePassword  Boolean               @default(true)
  advisor             Advisor?
  AdvisorAvailability AdvisorAvailability[]
  advisorProfile      AdvisorProfile?
  createdCars         Car[]                 @relation("CreatedBy")
  updatedCars         Car[]                 @relation("UpdatedBy")
  sessions            Session[]
}

model Advisor {
  advisorId String   @id @default(uuid())
  adminId   String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Car {
  id             String         @id @default(uuid())
  brand          String
  model          String
  price          Float
  year           Int
  mileage        Int
  images         String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())
  createdById    String?
  updatedById    String?
  condition      String?        @default("NULL")
  edition        String?        @default("NULL")
  transmission   String?
  bodyType       String?        @default("NULL")
  fuelType       String?
  engineCapacity Int?           @default(0) @db.SmallInt
  location       String?        @default("NULL")
  dealer         String?        @default("NULL")
  availability   Availability[]
  createdBy      Admin?         @relation("CreatedBy", fields: [createdById], references: [id])
  updatedBy      Admin?         @relation("UpdatedBy", fields: [updatedById], references: [id])
  reviews        Review[]
  CarVector      CarVector[]
  Transactions   Transactions[]

  @@map("Car")
}

model Branch {
  id            String         @id @default(uuid())
  name          String
  contactNumber String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
  location      String
  availability  Availability[]
}

model Availability {
  id        String   @id @default(uuid())
  carId     String
  branchId  String
  quantity  Int
  updatedAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])
  car       Car      @relation(fields: [carId], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  carId      String
  userId     String
  rating     Int
  comment    String
  adminReply String?
  location   String
  createdAt  DateTime @default(now())
  car        Car      @relation(fields: [carId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model Transactions {
  id         String @id @default(uuid())
  buyerName  String
  buyerEmail String
  phone      String
  location   String
  price      Float

  carId  String
  userId String

  createdAt DateTime @default(now())

  // Relations
  car  Car  @relation(fields: [carId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model NewsletterEntry {
  id        String           @id @default(uuid())
  userId    String?
  email     String           @unique
  createdAt DateTime         @default(now())
  source    NewsletterSource @default(GUEST)
  status    NewsletterStatus @default(ACTIVE)
  user      User?            @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([status])
}

model ConsultationBooking {
  id               String        @id @default(uuid())
  userId           String?
  fullName         String
  email            String
  phone            String
  vehicleType      String
  consultationType String
  preferredDate    DateTime
  preferredTime    String
  message          String?
  status           BookingStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  advisorMessage   String?
  advisorId        String?
  user             User?         @relation(fields: [userId], references: [id])
}

model Session {
  id           String   @id @default(uuid())
  userId       String?
  adminId      String?
  refreshToken String
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  admin        Admin?   @relation(fields: [adminId], references: [id])
  user         User?    @relation(fields: [userId], references: [id])
}

model NewsletterBroadcast {
  id                    String                  @id
  newsletterId          String
  status                BroadcastStatus         @default(PENDING)
  sentCount             Int                     @default(0)
  sentAt                DateTime?
  createdAt             DateTime                @default(now())
  Newsletter            Newsletter              @relation(fields: [newsletterId], references: [id])
  NewsletterDeliveryLog NewsletterDeliveryLog[]

  @@index([status])
}

model Newsletter {
  id                  String                @id
  title               String
  subject             String
  content             String
  createdAt           DateTime              @default(now())
  sentAt              DateTime?
  NewsletterBroadcast NewsletterBroadcast[]
}

model NewsletterDeliveryLog {
  id                  String              @id
  broadcastId         String
  email               String
  status              DeliveryStatus
  errorMessage        String?
  sentAt              DateTime            @default(now())
  NewsletterBroadcast NewsletterBroadcast @relation(fields: [broadcastId], references: [id])

  @@index([email])
}

model AdvisorAvailability {
  id        String   @id @default(uuid())
  advisorId String
  date      DateTime
  timeSlot  String
  isBusy    Boolean  @default(false)
  advisor   Admin    @relation(fields: [advisorId], references: [id])
}

model AdvisorProfile {
  id             String   @id @default(uuid())
  adminId        String   @unique
  phone          String?
  specialization String?
  experience     String?
  rating         Float    @default(0)
  avatar         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  admin          Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model VideoReview {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  youtubeId   String    @unique
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
}

model CarVector {
  id          String                @id @default(uuid()) @db.Uuid
  car_id      String
  chunk_index Int
  content     String
  embedding   Unsupported("vector")
  created_at  DateTime              @default(now())
  car         Car                   @relation(fields: [car_id], references: [id], onDelete: Cascade)

  @@index([car_id])
  @@map("car_vector")
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
  FORWARDED
}

enum BroadcastStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum NewsletterSource {
  GUEST
  USER
  ADMIN
}

enum NewsletterStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum StaffRole {
  admin
  advisor
  superadmin
}

model AuditLog {
  id       String  @id @default(uuid())
  action   String // e.g. "CREATE_ADVISOR", "BOOKING_CREATED"
  entity   String // e.g. "Advisor", "Booking"
  entityId String? // ID of affected record

  userId   String? // who performed the action
  userRole String? // ADMIN, ADVISOR, USER

  metadata Json? // extra details (before/after changes)

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model PasswordResetOTP {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
